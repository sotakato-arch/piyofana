# Copy to .env on the host and chmod 600. Never commit .env.
# The feed URL is the credential: anyone holding it can read the records.
PIYOLOG_FEED_URL=
# Generate on the host: openssl rand -hex 24
POSTGRES_PASSWORD=
# Feed creation date + 90 days on the free tier (YYYY-MM-DD). Optional.
FEED_EXPIRES_ON=
POLL_INTERVAL_S=600
# Read-only Grafana login password. Generate on the host: openssl rand -hex 24
GRAFANA_RO_PASSWORD=
# Private data source connect (from the Grafana Cloud console). Set all three,
# then add COMPOSE_PROFILES=pdc to start the agent.
GCLOUD_PDC_SIGNING_TOKEN=
GCLOUD_PDC_CLUSTER=
GCLOUD_HOSTED_GRAFANA_ID=
# COMPOSE_PROFILES=pdc
